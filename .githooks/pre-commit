#!/bin/sh
# #596 agent-identity rail.
#
# An agent session must commit under a seat identity, never the tree's human
# fallback config. Two seats fell back to the human
# identity within one hour on 2026-08-04 — with the failure mode already
# named, publicly, by both. Per-commit stamping is a note; this is the rail.
#
# A human terminal carries no agent marker, so the first line exits before
# any evaluation: an ordinary human `git commit` can never be refused here.
# (Hard boundary from the card, preserved by construction.)
#
# Installed via a one-line dispatcher in .git/hooks/pre-commit — deliberately
# NOT via core.hooksPath, which would replace .git/hooks entirely and silently
# disable the untracked pre-push history gate living there.

[ -n "$CLAUDECODE" ] || [ -n "$AI_AGENT" ] || exit 0

# #751 — seat identities that GitHub can actually attribute, matched by SHAPE.
#
# `*@manyhands.invalid` is RFC 2606 unroutable by design: it can never be
# verified on any account, so the contribution graph credited nobody and the
# public signal read "dormant" for a repo three seats ship into daily.
#
# ⚠️ SHAPES, NOT ADDRESSES, AND THE REASON IS PUBLICATION. The verified seat
# addresses are tagged variants of the owner's personal address. Writing them
# here would put a real-world identity into tracked public content — what the
# export gate exists to keep out — and shipping it would mean ratifying that
# into the gate's baseline permanently. The shape carries what this rail
# actually needs (is this a seat, or a fallback to the human?) and publishes
# nothing.
#
# ⇒ THE SEAM, stated rather than left to inference:
#     #596 (here, public)   proves the identity is SEAT-SHAPED, at commit time.
#     #561 (push, private)  proves the exact (name, verified email) PAIR.
#   A deliberate narrowing of what this hook promises, authorized by the repo
#   owner 2026-08-09. It is coarser than an exact list ON PURPOSE: a glob
#   cannot constrain the local-part before the tag, so this accepts identities
#   the push gate will still refuse. Cheap and early here; exact at the
#   boundary that actually publishes.
#
# ⚠️ PHASE 2 — TIGHTENED 2026-08-09. The legacy `*@manyhands.invalid` entry is
# GONE. All three seats stated their new identity in the commons before this
# landed, so nothing is half-migrated: there is no per-seat config to switch,
# and each seat's first tagged commit IS its switch.
#
# Phase 1 kept the legacy rule for two reasons, and both are now spent: the
# bootstrap commit needed it, and this rail's suite stamped a synthetic seat
# whose name the tightened list cannot accept. That suite now DERIVES a valid
# identity from the list below rather than hardcoding one — so the test file
# still carries no seat name of its own, and a fourth seat cannot be added
# without the inventory assertion going red.
#
# ⇒ From here, a `.invalid` identity is REFUSED. That is the point: keeping both
#   forever would leave the silent regression available permanently, with this
#   hook still green.
HOOKDIR=$(dirname "$0")
if [ ! -r "$HOOKDIR/seat-identities.sh" ]; then
  # Fail CLOSED. A rail that cannot load its own definition of a seat must not
  # wave commits through: an unreadable list is not an empty one.
  echo "pre-commit (#596): cannot read $HOOKDIR/seat-identities.sh — refusing rather" >&2
  echo "  than guessing what a seat identity is." >&2
  exit 1
fi
. "$HOOKDIR/seat-identities.sh"

# BOTH identity slots must be seats. An --amend preserves the author and
# silently resets the committer from config — exactly the half-checked shape
# that shipped as "amended clean" on 2026-08-04. -c user.* sets both, so a
# correctly stamped commit passes untouched.
for slot in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
  # `git var`, never `git config user.*`: GIT_AUTHOR_* environment variables
  # override config, so reading config would validate a value the commit is not
  # going to use. This asks git what it will actually write.
  who=$(seat_ident_of "$(git var "$slot" 2>/dev/null)")
  if ! seat_ident_matches "$who"; then
    echo "pre-commit (#596): agent session committing without a seat identity." >&2
    echo "  $slot: $who" >&2
    echo "  accepted seat identities:" >&2
    printf '    %s\n' "$SEAT_IDENTS" >&2
    echo "  stamp your seat:  git -c user.name='<Seat>' -c user.email='<seat address>' commit ..." >&2
    exit 1
  fi
done
exit 0
