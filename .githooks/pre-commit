#!/bin/sh
# #596 agent-identity rail.
#
# An agent session must commit under a seat identity (*@manyhands.invalid),
# never the tree's human fallback config. Two seats fell back to the human
# identity within one hour on 2026-08-04 — with the failure mode already
# named, publicly, by both. Per-commit stamping is a note; this is the rail.
#
# A human terminal carries no agent marker, so the first line exits before
# any evaluation: an ordinary human `git commit` can never be refused here.
# (Hard boundary from the card, preserved by construction.)
#
# Installed via a one-line dispatcher in .git/hooks/pre-commit — deliberately
# NOT via core.hooksPath, which would replace .git/hooks entirely and silently
# disable the untracked pre-push history gate living there.

[ -n "$CLAUDECODE" ] || [ -n "$AI_AGENT" ] || exit 0

# BOTH identity slots must be seats. An --amend preserves the author and
# silently resets the committer from config — exactly the half-checked shape
# that shipped as "amended clean" on 2026-08-04. -c user.* sets both, so a
# correctly stamped commit passes untouched.
for slot in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
  ident=$(git var "$slot" 2>/dev/null)
  case "$ident" in
    *"@manyhands.invalid>"*) ;;
    *)
      echo "pre-commit (#596): agent session committing without a seat identity." >&2
      echo "  $slot: $ident" >&2
      echo "  stamp your seat:  git -c user.name='<Seat>' -c user.email='<seat>@manyhands.invalid' commit ..." >&2
      exit 1 ;;
  esac
done
exit 0
