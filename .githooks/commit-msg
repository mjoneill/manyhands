#!/bin/sh
# #596 agent-identity rail, second detector: the commit ARTIFACT, not the env.
#
# The env-marker pre-commit covers seats whose runtime carries CLAUDECODE /
# AI_AGENT — but one seat's gateway provably inherits neither, cannot verify
# its own env from inside, and would sail through as the human fallback while
# the covered seats report the rail working. This detector keys on what every
# toolchain produces and every seat can check for itself: the commit message.
#
# Refuse when the author is NOT a seat identity but the message carries a
# Co-Authored-By trailer naming one — author and trailer disagreeing is the
# exact signature of a seat committing under the human fallback (cea6597).
# A human commit carries no seat trailer, so it is never evaluated.

# ⚠️ #751 phase 2 — THIS RAIL HAD GONE INERT AND NOTHING SAID SO.
#
# It asked two questions of the wrong thing — a retired DOMAIN, in both the
# author ident and the trailer. Every seat trailer in this repository reads
# `Co-Authored-By: <Seat> <noreply@anthropic.com>`, which never matched, so the
# rail's own target case — human author, seat trailer — passed straight through.
# Measured 2026-08-09; found only because a neighbouring change forced the file
# open. A guard keyed to a SPELLING dies when the spelling changes; a guard
# keyed to the PROPERTY survives it.
#
# ⇒ Now: is the AUTHOR a seat (shared list, same predicate as pre-commit), and
#   does the trailer name a seat BY NAME, whatever address it carries?
HOOKDIR=$(dirname "$0")
if [ ! -r "$HOOKDIR/seat-identities.sh" ]; then
  echo "commit-msg (#596): cannot read $HOOKDIR/seat-identities.sh — refusing rather" >&2
  echo "  than guessing what a seat identity is." >&2
  exit 1
fi
. "$HOOKDIR/seat-identities.sh"

trailer_names_a_seat "$1" || exit 0   # no seat trailer — an ordinary commit

# Both slots: an amend preserves the author but resets the committer from
# config, so a half-stamped commit disagrees with its trailer in the
# committer slot only.
for slot in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
  who=$(seat_ident_of "$(git var "$slot" 2>/dev/null)")
  if ! seat_ident_matches "$who"; then
    echo "commit-msg (#596): identity and trailer disagree — a seat trailer under a non-seat identity." >&2
    echo "  $slot: $who" >&2
    echo "  accepted seat identities:" >&2
    printf '    %s\n' "$SEAT_IDENTS" >&2
    echo "  stamp your seat:  git -c user.name='<Seat>' -c user.email='<seat address>' commit ..." >&2
    exit 1
  fi
done
exit 0
